{
  "@context": {
    "@base": "https://democlip.dev/ontology/",
    "@vocab": "https://democlip.dev/ontology#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "label": "rdfs:label",
    "target": { "@type": "@id" },
    "realises": { "@type": "@id" },
    "owner": { "@type": "@id" },
    "dependsOn": { "@type": "@id" }
  },
  "name": "DemoClip ontology",
  "description": "One model of the audiovisual-production domain DemoClip works in: the problem domain (the reality) and the solution domain (how the app models it), the rules that hold, and the traceability between them.",
  "version": "1.0.0",
  "sources": {
    "words": "docs/GLOSSARY.md",
    "reasoning": "docs/research/PROBLEM_DOMAIN_MODEL.md",
    "humanView": ["docs/ontology/README.md", "docs/ontology/problem-domain.md", "docs/ontology/solution-domain.md", "docs/ontology/rules.md", "docs/ontology/alignment.md"]
  },
  "relatedOntologies": [
    { "id": "ma-ont", "name": "W3C Ontology for Media Resources 1.0", "uri": "https://www.w3.org/TR/mediaont-10/", "namespace": "http://www.w3.org/ns/ma-ont#", "note": "core vocabulary for media resources; the closest general one" },
    { "id": "ebucore", "name": "EBUCore", "uri": "https://www.ebu.ch/metadata/ontologies/ebucore/ebucore", "note": "the EBU's audiovisual metadata, an extension of ma-ont; used with the EBU CCDM" },
    { "id": "oa", "name": "W3C Web Annotation Data Model", "uri": "https://www.w3.org/TR/annotation-model/", "namespace": "http://www.w3.org/ns/oa#", "note": "annotations with a body, a target and selectors" },
    { "id": "media-frags", "name": "W3C Media Fragments URI 1.0", "uri": "https://www.w3.org/TR/media-frags/", "note": "temporal t= and spatial xywh fragments" },
    { "id": "schema-org", "name": "schema.org", "uri": "https://schema.org/", "note": "VideoObject, Clip, CreativeWork; the web publishing side" },
    { "id": "prov-o", "name": "W3C PROV Ontology", "uri": "https://www.w3.org/TR/prov-o/", "namespace": "http://www.w3.org/ns/prov#", "note": "provenance: Entity, Activity, Agent" }
  ],
  "@graph": [
    { "@id": "creator", "@type": "Actor", "label": "Creator", "layer": "problem", "area": "actors", "summary": "The person producing the content." },
    { "@id": "audience", "@type": "Actor", "label": "Audience", "layer": "problem", "area": "actors", "summary": "The person the content is made for. Not modelled by DemoClip." },
    { "@id": "ai-agent", "@type": "Actor", "label": "AI agent", "layer": "problem", "area": "actors", "summary": "A program that co-produces, on the same concepts and rules as a person.", "realises": ["automation-surface", "mcp-server"] },
    { "@id": "destination", "@type": "Actor", "label": "Destination", "layer": "problem", "area": "actors", "summary": "A service that receives and shows content under its own rules.", "realises": ["publish-to-bluesky", "publish-to-youtube"] },
    { "@id": "external-tool", "@type": "Actor", "label": "External tool", "layer": "problem", "area": "actors", "summary": "Software outside the app that works on a file, and hands it back.", "realises": ["sidecar", "import-take"] },
    { "@id": "host-browser", "@type": "Actor", "label": "Host browser", "layer": "problem", "area": "actors", "summary": "The environment the app runs in: its capture, storage and encoding APIs." },

    { "@id": "goal-demonstrate", "@type": "Goal", "label": "Demonstrate", "layer": "problem", "area": "goals", "summary": "Show how something works." },
    { "@id": "goal-teach", "@type": "Goal", "label": "Teach", "layer": "problem", "area": "goals", "summary": "Instruct, step by step." },
    { "@id": "goal-report", "@type": "Goal", "label": "Report", "layer": "problem", "area": "goals", "summary": "Tell what happened." },
    { "@id": "goal-promote", "@type": "Goal", "label": "Promote", "layer": "problem", "area": "goals", "summary": "Attract an audience to something." },
    { "@id": "goal-archive", "@type": "Goal", "label": "Archive", "layer": "problem", "area": "goals", "summary": "Keep a record." },
    { "@id": "goal-communicate", "@type": "Goal", "label": "Communicate", "layer": "problem", "area": "goals", "summary": "Get an idea across; the umbrella the others sit under." },

    { "@id": "process-intent", "@type": "Process", "label": "Intent", "layer": "problem", "area": "process", "summary": "Decide why the content is made, and for whom.", "relations": [{ "kind": "worksOn", "target": "production" }] },
    { "@id": "process-capture", "@type": "Process", "label": "Capture", "layer": "problem", "area": "process", "summary": "Make or import the material the content is built from.", "relations": [{ "kind": "produces", "target": "source-material" }] },
    { "@id": "process-organise", "@type": "Process", "label": "Organise", "layer": "problem", "area": "process", "summary": "Group the work under a body of work.", "relations": [{ "kind": "worksOn", "target": "production" }] },
    { "@id": "process-review", "@type": "Process", "label": "Review", "layer": "problem", "area": "process", "summary": "Watch and find the moments that matter.", "relations": [{ "kind": "worksOn", "target": "production-instance" }] },
    { "@id": "process-cut", "@type": "Process", "label": "Cutting", "layer": "problem", "area": "process", "summary": "Decide what to drop.", "relations": [{ "kind": "worksOn", "target": "cutting" }] },
    { "@id": "process-compose", "@type": "Process", "label": "Compose", "layer": "problem", "area": "process", "summary": "Add what explains the picture, and the brand.", "relations": [{ "kind": "worksOn", "target": "composition" }, { "kind": "worksOn", "target": "branding" }] },
    { "@id": "process-prepare", "@type": "Process", "label": "Prepare", "layer": "problem", "area": "process", "summary": "Decide the form the finished file takes.", "relations": [{ "kind": "produces", "target": "output" }] },
    { "@id": "process-distribute", "@type": "Process", "label": "Distribute", "layer": "problem", "area": "process", "summary": "Deliver the content to a destination.", "relations": [{ "kind": "produces", "target": "publication" }] },
    { "@id": "process-keep", "@type": "Process", "label": "Keep and resume", "layer": "problem", "area": "process", "summary": "Let work survive an interruption.", "relations": [{ "kind": "worksOn", "target": "production-instance" }] },

    { "@id": "production", "@type": "Concept", "label": "Production", "layer": "problem", "area": "production", "summary": "A body of work and the reason for it — its goals, in a creator's words.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["project"] },
    { "@id": "production-environment", "@type": "Concept", "label": "Production environment", "layer": "problem", "area": "production", "summary": "The fixed configuration a way of working needs, so none of it is forgotten or got wrong.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["profile", "clip-profile"] },
    { "@id": "production-instance", "@type": "Concept", "label": "Production instance", "layer": "problem", "area": "production", "summary": "One piece of content being made, from its first material to its last output.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["clip", "recording", "session"] },
    { "@id": "source-material", "@type": "Concept", "label": "Source material", "layer": "problem", "area": "production", "summary": "The recording or the imported file a production instance is built from.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["take", "take-file"] },
    { "@id": "cutting", "@type": "Concept", "label": "Cutting", "layer": "problem", "area": "production", "summary": "The decisions about which stretches of the material are kept.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["cut", "spanset"] },
    { "@id": "composition", "@type": "Concept", "label": "Composition", "layer": "problem", "area": "production", "summary": "What is laid over the material to explain it: marks, pictures, words, sound.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["annotation"] },
    { "@id": "branding", "@type": "Concept", "label": "Branding", "layer": "problem", "area": "production", "summary": "The identity a production wears: its mark, its name, its colour.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["clip-properties", "logo", "watermark", "title-card", "annotation-colour"] },
    { "@id": "output", "@type": "Concept", "label": "Output", "layer": "problem", "area": "production", "summary": "The finished file: the kept material, the composition drawn in, one form.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["export-plan", "export-target", "export-resolution"] },
    { "@id": "publication", "@type": "Concept", "label": "Publication", "layer": "problem", "area": "distribution", "summary": "The content as delivered to a destination, under that destination's rules.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["publish-to-bluesky", "publish-to-youtube", "upload"] },
    { "@id": "channel", "@type": "Concept", "label": "Channel", "layer": "problem", "area": "distribution", "summary": "The surface a destination exposes to an audience — an account, a feed.", "definedIn": "docs/ontology/problem-domain.md", "realises": ["visibility", "uploadable-video"] },

    { "@id": "constraint-non-destructive", "@type": "Constraint", "label": "An edit never changes the material", "layer": "problem", "area": "constraints", "summary": "The material is the record; a decision about it must be reversible, and re-encoding loses what was recorded." },
    { "@id": "constraint-local-first", "@type": "Constraint", "label": "Content stays on the machine unless published", "layer": "problem", "area": "constraints", "summary": "The work is private by default; the app needs no account or server." },
    { "@id": "constraint-destination-limits", "@type": "Constraint", "label": "A destination's form and ceiling are honoured before work is spent", "layer": "problem", "area": "constraints", "summary": "A clip too long for a channel is refused before it is encoded, not after." },
    { "@id": "constraint-config-consistency", "@type": "Constraint", "label": "A way of working applies the same configuration every time", "layer": "problem", "area": "constraints", "summary": "Branding and loudness must not be forgotten, missed or got wrong." },
    { "@id": "constraint-session-boundary", "@type": "Constraint", "label": "The configuration is fixed once capture begins", "layer": "problem", "area": "constraints", "summary": "Nothing may move under content already being made." },
    { "@id": "constraint-browser-capability", "@type": "Constraint", "label": "The app may use only what the browser gives it", "layer": "problem", "area": "constraints", "summary": "The app is client-only; capture, storage and encoding are the browser's." },

    { "@id": "session", "@type": "SolutionConcept", "label": "Session", "layer": "solution", "area": "production", "summary": "One sitting: the clip, and whether capture has begun.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/session/Session.ts" },
    { "@id": "clip", "@type": "SolutionConcept", "label": "Clip", "layer": "solution", "area": "production", "summary": "The aggregate: the takes, the cuts, the annotations, and what it says about itself.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/Clip.ts", "realises": ["production-instance"], "relations": [{ "kind": "aggregates", "target": "take" }, { "kind": "aggregates", "target": "spanset" }, { "kind": "holds", "target": "annotation" }, { "kind": "dependsOn", "target": "take-repository" }] },
    { "@id": "take", "@type": "SolutionConcept", "label": "Take", "layer": "solution", "area": "production", "summary": "One arrival of material: a press of Record, or an import.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/Take.ts" },
    { "@id": "take-file", "@type": "SolutionConcept", "label": "Take file", "layer": "solution", "area": "production", "summary": "A WebM or MP4 chosen to import.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/TakeFile.ts" },
    { "@id": "import-take", "@type": "SolutionConcept", "label": "Import", "layer": "solution", "area": "production", "summary": "A take file read and appended as a take; nothing re-recorded.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/application/import-take.ts" },
    { "@id": "take-repository", "@type": "SolutionConcept", "label": "Take repository", "layer": "solution", "area": "production", "summary": "The port the clip takes its takes from; the only owner of their object URLs.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/TakeRepository.ts" },
    { "@id": "source-set", "@type": "SolutionConcept", "label": "Source set", "layer": "solution", "area": "production", "summary": "Which of screen, webcam and microphone are on; all off at start.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/capture/SourceSet.ts" },
    { "@id": "crop-region", "@type": "SolutionConcept", "label": "Crop region", "layer": "solution", "area": "production", "summary": "The rectangle of the screen being recorded, as fractions.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/capture/CropRegion.ts" },
    { "@id": "webcam-bubble", "@type": "SolutionConcept", "label": "Webcam bubble", "layer": "solution", "area": "production", "summary": "Where and how big the camera sits over the picture; per sitting, never kept.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/capture/WebcamBubble.ts" },
    { "@id": "clip-size", "@type": "SolutionConcept", "label": "Clip size", "layer": "solution", "area": "production", "summary": "The picture the clip is worked in, derived from the takes, never set.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/ClipSize.ts" },

    { "@id": "span", "@type": "SolutionConcept", "label": "Span", "layer": "solution", "area": "editing", "summary": "A half-open range [s, e): the smallest thing a timeline is made of.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/Span.ts" },
    { "@id": "spanset", "@type": "SolutionConcept", "label": "Span set", "layer": "solution", "area": "editing", "summary": "Ranges that cannot overlap — what was cut.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/SpanSet.ts" },
    { "@id": "cut", "@type": "SolutionConcept", "label": "Cut", "layer": "solution", "area": "editing", "summary": "A section that was approved: it leaves the timeline, and playback and the export skip it.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/Clip.ts" },
    { "@id": "mark", "@type": "SolutionConcept", "label": "Mark", "layer": "solution", "area": "editing", "summary": "A position placed by a click; view state, not the clip's.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/cutting/selection.ts" },
    { "@id": "section", "@type": "SolutionConcept", "label": "Section", "layer": "solution", "area": "editing", "summary": "The stretch two marks bound — a proposal, nothing has left the clip.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/cutting/selection.ts" },
    { "@id": "selection", "@type": "SolutionConcept", "label": "Selection", "layer": "solution", "area": "editing", "summary": "The stretch the user is pointing at, and the action chosen for it.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/cutting/selection.ts" },
    { "@id": "timeline-map", "@type": "SolutionConcept", "label": "Timeline map", "layer": "solution", "area": "editing", "summary": "The only place that converts between recording time and kept time.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/TimelineMap.ts" },

    { "@id": "annotation", "@type": "SolutionConcept", "label": "Annotation", "layer": "solution", "area": "composition", "summary": "Something drawn over the picture for a stretch of the clip's time.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/annotation/Annotation.ts", "relations": [{ "kind": "dependsOn", "target": "annotation-kind" }] },
    { "@id": "annotation-kind", "@type": "SolutionConcept", "label": "Annotation kind", "layer": "solution", "area": "composition", "summary": "What makes one annotation different: its rules, normalisation and hit test.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/annotation/kinds.ts" },
    { "@id": "annotation-plugin", "@type": "SolutionConcept", "label": "Annotation plugin", "layer": "solution", "area": "composition", "summary": "A kind in the view: its action, renderer and how a new one is made.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/annotating/annotation-plugin.ts" },
    { "@id": "annotation-canvas", "@type": "SolutionConcept", "label": "Annotation canvas", "layer": "solution", "area": "composition", "summary": "The one shared editing surface every kind gets, naming no kind.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/annotating/annotation-canvas.ts" },
    { "@id": "annotation-layer", "@type": "SolutionConcept", "label": "Annotation layer", "layer": "solution", "area": "composition", "summary": "The one place an annotation is drawn — by playback and by the export alike.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/annotating/annotation-layer.ts" },
    { "@id": "annotation-lane", "@type": "SolutionConcept", "label": "Annotation lane", "layer": "solution", "area": "composition", "summary": "The timeline row where each annotation is found, in kept time.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/annotating/annotation-lane.ts" },
    { "@id": "properties-inspector", "@type": "SolutionConcept", "label": "Properties inspector", "layer": "solution", "area": "composition", "summary": "The one surface that edits a picked annotation's properties.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/annotating/properties-inspector.ts" },
    { "@id": "arrow", "@type": "SolutionConcept", "label": "Arrow", "layer": "solution", "area": "composition", "summary": "The first kind: a line with a head, given by from and to.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/annotation/Arrow.ts" },
    { "@id": "image-annotation", "@type": "SolutionConcept", "label": "Image annotation", "layer": "solution", "area": "composition", "summary": "A chosen picture over the picture, a rect keeping proportions.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/annotation/ImageAnnotation.ts" },
    { "@id": "text-annotation", "@type": "SolutionConcept", "label": "Text annotation", "layer": "solution", "area": "composition", "summary": "A line of text over the picture, a box that scales with its font.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/annotation/TextAnnotation.ts" },
    { "@id": "sound-annotation", "@type": "SolutionConcept", "label": "Sound annotation", "layer": "solution", "area": "composition", "summary": "A stock sound over a stretch, mixed with the recorded sound.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/annotation/SoundAnnotation.ts" },
    { "@id": "magnifier", "@type": "SolutionConcept", "label": "Magnifier", "layer": "solution", "area": "composition", "summary": "A lens over a detail, showing it enlarged and dimming the rest.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/annotation/Magnifier.ts" },

    { "@id": "clip-properties", "@type": "SolutionConcept", "label": "Clip properties", "layer": "solution", "area": "branding", "summary": "What the clip says about itself, declared by the app and kept with the clip.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/ClipProperties.ts" },
    { "@id": "clip-property", "@type": "SolutionConcept", "label": "Clip property", "layer": "solution", "area": "branding", "summary": "One of them: a label, a control, and how to read and write the value.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/clip/clip-properties.ts" },
    { "@id": "logo", "@type": "SolutionConcept", "label": "Logo", "layer": "solution", "area": "branding", "summary": "A mark the app serves, worn on the title card and as a watermark.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/logos.ts" },
    { "@id": "watermark", "@type": "SolutionConcept", "label": "Watermark", "layer": "solution", "area": "branding", "summary": "The logo and title as annotations over the whole clip.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/clip/watermark.ts" },
    { "@id": "title-card", "@type": "SolutionConcept", "label": "Title card", "layer": "solution", "area": "branding", "summary": "The head an export puts on a file: the first frame held, with the clip's words.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/IntroCard.ts" },
    { "@id": "annotation-colour", "@type": "SolutionConcept", "label": "Annotation colour", "layer": "solution", "area": "branding", "summary": "The colour a new annotation is made in; a profile may fix it.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/annotation/AnnotationColour.ts" },
    { "@id": "export-resolution", "@type": "SolutionConcept", "label": "Export resolution", "layer": "solution", "area": "branding", "summary": "The size the file is written at: the clip size scaled by one factor.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/ExportResolution.ts" },

    { "@id": "profile", "@type": "SolutionConcept", "label": "Profile", "layer": "solution", "area": "context", "summary": "A named set of the app's configuration a person works under; a production environment.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/profile/Profile.ts", "realises": ["production-environment"] },
    { "@id": "active-profile", "@type": "SolutionConcept", "label": "Active profile", "layer": "solution", "area": "context", "summary": "The one profile in force; fixed once capture begins.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/profile/Profiles.ts" },
    { "@id": "declaration", "@type": "SolutionConcept", "label": "Declaration", "layer": "solution", "area": "context", "summary": "What a profile says about one item — that it controls it, and its value.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/profile/Profile.ts" },
    { "@id": "controlled-item", "@type": "SolutionConcept", "label": "Controlled item", "layer": "solution", "area": "context", "summary": "An item the active profile declares: applied and locked, not the person's.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/profile/control.ts" },
    { "@id": "clip-profile", "@type": "SolutionConcept", "label": "Clip profile", "layer": "solution", "area": "context", "summary": "The profile a recording was made under, snapshotted at capture.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/ClipProfile.ts" },
    { "@id": "project", "@type": "SolutionConcept", "label": "Project", "layer": "solution", "area": "context", "summary": "A body of work and its reason: name, description and default profile.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/project/Project.ts", "realises": ["production"] },
    { "@id": "projects-book", "@type": "SolutionConcept", "label": "Project book", "layer": "solution", "area": "context", "summary": "Where the projects outlive the page: localStorage.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/infra/project-store.ts" },
    { "@id": "recording", "@type": "SolutionConcept", "label": "Recording", "layer": "solution", "area": "context", "summary": "A clip that belongs to a project, with the profile it was made under.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/application/recordings.ts" },
    { "@id": "recording-store", "@type": "SolutionConcept", "label": "Recording store", "layer": "solution", "area": "context", "summary": "Where recordings outlive the page: IndexedDB, keyed by recording.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/infra/recording-store.ts" },
    { "@id": "open-pointer", "@type": "SolutionConcept", "label": "Open pointer", "layer": "solution", "area": "context", "summary": "Which recording the sitting is on; written with a recording's first meta.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/infra/recording-store.ts" },

    { "@id": "segment", "@type": "SolutionConcept", "label": "Segment", "layer": "solution", "area": "output", "summary": "A kept stretch of one take: { takeIndex, from, to }.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/Clip.ts" },
    { "@id": "export-plan", "@type": "SolutionConcept", "label": "Export plan", "layer": "solution", "area": "output", "summary": "The kept stretches placed on the output timeline, with the joins — decided before a frame is encoded.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/ExportPlan.ts" },
    { "@id": "export-target", "@type": "SolutionConcept", "label": "Export target", "layer": "solution", "area": "output", "summary": "Which container an export writes, and the picture the encoder is given.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/export/ExportTarget.ts" },
    { "@id": "fade", "@type": "SolutionConcept", "label": "Fade", "layer": "solution", "area": "output", "summary": "The sound going down over the end of a take and up as the next begins.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/clip/fade.ts" },
    { "@id": "dissolve", "@type": "SolutionConcept", "label": "Dissolve", "layer": "solution", "area": "output", "summary": "The picture blending from one take into the next over the same 80 ms.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/clip/dissolve.ts" },
    { "@id": "sidecar", "@type": "SolutionConcept", "label": "Sidecar", "layer": "solution", "area": "output", "summary": "The annotations written beside a file, so a clip that leaves comes back whole.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/clip/AnnotationSidecar.ts" },
    { "@id": "publish-to-bluesky", "@type": "SolutionConcept", "label": "Publish to Bluesky", "layer": "solution", "area": "distribution", "summary": "The first destination: an OAuth session and XRPC calls behind a port.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/application/publish-to-bluesky.ts" },
    { "@id": "publish-to-youtube", "@type": "SolutionConcept", "label": "Publish to YouTube", "layer": "solution", "area": "distribution", "summary": "The second destination: Google's token model and a resumable upload.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/application/publish-to-youtube.ts" },
    { "@id": "bluesky-post", "@type": "SolutionConcept", "label": "Bluesky post", "layer": "solution", "area": "distribution", "summary": "The app.bsky.feed.post record carrying the video embed.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/bluesky/BlueskyPost.ts" },
    { "@id": "uploadable-video", "@type": "SolutionConcept", "label": "YouTube video", "layer": "solution", "area": "distribution", "summary": "The MP4 the app sends YouTube, with the destination's ceilings.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/youtube/UploadableVideo.ts" },
    { "@id": "video-details", "@type": "SolutionConcept", "label": "Video details", "layer": "solution", "area": "distribution", "summary": "The title (defaulted when blank), description and visibility.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/youtube/VideoDetails.ts" },
    { "@id": "visibility", "@type": "SolutionConcept", "label": "Visibility", "layer": "solution", "area": "distribution", "summary": "Who may see the video: private, unlisted or public; private where it starts.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/domain/youtube/Visibility.ts" },
    { "@id": "upload", "@type": "SolutionConcept", "label": "Upload", "layer": "solution", "area": "distribution", "summary": "The transfer of the bytes: a resumable session, watched by the byte.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/infra/youtube.ts" },

    { "@id": "automation-surface", "@type": "SolutionConcept", "label": "Automation surface", "layer": "solution", "area": "agent", "summary": "The app's own operations in one object, published only when the page asks.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/agent/surface.ts" },
    { "@id": "operation", "@type": "SolutionConcept", "label": "Operation", "layer": "solution", "area": "agent", "summary": "One thing an agent may do, named in the app's vocabulary.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "src/ui/agent/" },
    { "@id": "mcp-server", "@type": "SolutionConcept", "label": "MCP server", "layer": "solution", "area": "agent", "summary": "The local program that opens the browser and offers the surface as tools.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "mcp/" },
    { "@id": "agent-session", "@type": "SolutionConcept", "label": "Agent session", "layer": "solution", "area": "agent", "summary": "One sitting driven by an agent: the browser, the clip, and the person watching.", "definedIn": "docs/GLOSSARY.md", "implementedBy": "mcp/src/server.ts" },

    { "@id": "rule-length-derived", "@type": "Rule", "label": "A clip's length is the sum of its takes", "category": "invariant", "owner": "clip", "proof": "src/domain/clip/Clip.test.ts" },
    { "@id": "rule-spanset-no-overlap", "@type": "Rule", "label": "Cut ranges never overlap", "category": "invariant", "owner": "spanset", "proof": "src/domain/clip/SpanSet.test.ts" },
    { "@id": "rule-take-has-length", "@type": "Rule", "label": "A take cannot be built without a length, and its length cannot be zero", "category": "invariant", "owner": "take", "proof": "src/domain/clip/Take.test.ts" },
    { "@id": "rule-even-edges", "@type": "Rule", "label": "The clip size and the export resolution are even in both dimensions", "category": "invariant", "owner": "clip-size", "proof": "src/domain/clip/ClipSize.test.ts" },
    { "@id": "rule-annotation-fractions", "@type": "Rule", "label": "An annotation's geometry is in fractions of the picture", "category": "invariant", "owner": "annotation", "proof": "src/domain/annotation/Annotation.test.ts" },
    { "@id": "rule-watermark-own-property", "@type": "Rule", "label": "Each watermark part follows its own clip property", "category": "invariant", "owner": "watermark", "proof": "src/ui/clip/watermark tests" },
    { "@id": "rule-recording-one-project", "@type": "Rule", "label": "A recording belongs to exactly one project at all times", "category": "invariant", "owner": "recording", "proof": "the stored record's shape" },
    { "@id": "rule-one-open-recording", "@type": "Rule", "label": "At most one recording is open; every other is finished", "category": "invariant", "owner": "open-pointer", "proof": "src/application/recordings tests" },
    { "@id": "rule-state-derived", "@type": "Rule", "label": "In progress and finished are derived from the session, never stored", "category": "invariant", "owner": "recording", "proof": "src/application/recordings tests" },
    { "@id": "rule-default-project-immune", "@type": "Rule", "label": "The Default project can be neither renamed nor removed", "category": "invariant", "owner": "projects-book", "proof": "src/domain/project/Projects.test.ts" },
    { "@id": "rule-default-profile-immune", "@type": "Rule", "label": "The built-in Empty profile declares nothing and is never renamed or removed", "category": "invariant", "owner": "profile", "proof": "src/domain/profile/Profiles.test.ts" },
    { "@id": "rule-cut-skipped", "@type": "Rule", "label": "A cut is skipped by playback and the export; the bytes are never re-encoded", "category": "business", "owner": "clip", "proof": "src/domain/clip/Clip.test.ts" },
    { "@id": "rule-one-undo", "@type": "Rule", "label": "One undo takes back the person's last change, and never a profile's value", "category": "business", "owner": "clip", "proof": "src/domain/clip/Clip.test.ts" },
    { "@id": "rule-profile-fixed", "@type": "Rule", "label": "A profile is fixed from the moment capture begins until the session ends", "category": "business", "owner": "session", "proof": "specs/016-projects" },
    { "@id": "rule-snapshot-config", "@type": "Rule", "label": "A recording keeps the profile snapshot it was made under", "category": "business", "owner": "clip-profile", "proof": "src/domain/clip/ClipProfile.test.ts" },
    { "@id": "rule-controlled-item-locked", "@type": "Rule", "label": "An item the active profile declares is applied and not the person's to change", "category": "business", "owner": "controlled-item", "proof": "src/ui/profile/control.ts" },
    { "@id": "rule-export-offline", "@type": "Rule", "label": "The export encodes offline and does not play; the file carries a duration and cues", "category": "business", "owner": "export-plan", "proof": "specs/013-export-resolution" },
    { "@id": "rule-destination-limits-first", "@type": "Rule", "label": "A destination's ceiling is refused before a frame is encoded", "category": "business", "owner": "uploadable-video", "proof": "src/domain/youtube/UploadableVideo.test.ts" },
    { "@id": "rule-sound-only-refused", "@type": "Rule", "label": "A video destination refuses a sound-only clip", "category": "business", "owner": "publish-to-youtube", "proof": "src/application/publish-to-youtube tests" },
    { "@id": "rule-title-defaulted", "@type": "Rule", "label": "A video title left blank is defaulted, never uploaded empty", "category": "business", "owner": "video-details", "proof": "src/domain/youtube/VideoDetails.test.ts" },
    { "@id": "rule-private-first", "@type": "Rule", "label": "Visibility is sent explicitly and starts private", "category": "business", "owner": "visibility", "proof": "src/domain/youtube/Visibility.test.ts" },
    { "@id": "rule-no-account-read", "@type": "Rule", "label": "The app asks for the upload scope alone and reads nothing about an account", "category": "business", "owner": "publish-to-youtube", "proof": "specs/007-youtube-export" },
    { "@id": "rule-sidecar-same-length", "@type": "Rule", "label": "A sidecar is taken only while the lengths agree", "category": "business", "owner": "sidecar", "proof": "src/domain/clip/AnnotationSidecar.test.ts" },
    { "@id": "rule-agent-no-destruction", "@type": "Rule", "label": "The agent's tool list contains no deletion and no project removal", "category": "business", "owner": "mcp-server", "proof": "mcp/src/tools.ts" },
    { "@id": "rule-sound-only-export", "@type": "Rule", "label": "A clip whose kept stretches have no picture writes the sound alone", "category": "business", "owner": "clip", "proof": "specs/011-record-audio-only" },
    { "@id": "rule-domain-pure", "@type": "Rule", "label": "src/domain/ imports no DOM, no browser API, and nothing from ui/ or infra/", "category": "codebase", "proof": "eslint / review" },
    { "@id": "rule-one-place", "@type": "Rule", "label": "A rule lives in one place, and everything asks it", "category": "codebase", "proof": "review" },
    { "@id": "rule-view-listens", "@type": "Rule", "label": "The clip announces what changed and the modules that draw it react", "category": "codebase", "proof": ".agents/skills/domain-model" },
    { "@id": "rule-message-translated", "@type": "Rule", "label": "Every message a person can see is a translation key, in both catalogues", "category": "codebase", "proof": "src/ui/i18n/catalogs.test.ts" },
    { "@id": "rule-words-first", "@type": "Rule", "label": "A new word is written into the glossary before it appears in code", "category": "codebase", "proof": ".agents/skills/domain-model" },
    { "@id": "rule-tests-with-the-rule", "@type": "Rule", "label": "A rule in src/domain/ has a unit test beside it; anything drawn needs a browser check", "category": "codebase", "proof": ".agents/skills/verification" }
  ]
}
