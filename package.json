{
  "name": "democlip",
  "version": "1.0.158",
  "private": true,
  "description": "Pure browser screen recorder — WebM & GIF with timeline trimming.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:https": "vite preview --mode https",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mcp": "npm --prefix mcp run build && npm --prefix mcp test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.15",
    "mediabunny": "^1.66.1"
  }
}
